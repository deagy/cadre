{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic SDLC provider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "kernel_compatibility",
    "agent_catalog",
    "profile_roots",
    "extension_roots"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "kernel_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum_exclusive"],
      "properties": {
        "minimum": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "maximum_exclusive": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "agent_catalog": {"type": "string", "minLength": 1},
    "profile_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "extension_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "version_range"], "properties": {"id": {"type": "string"}, "version_range": {"type": "string"}}}},
    "dispatch_bindings": {"type": "string", "minLength": 1}
  }
}
