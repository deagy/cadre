{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/cadre-routing.schema.json",
  "title": "Cadre routing configuration (roster/orchestration/routing.json)",
  "description": "Full documented shape of routing.json (JSON syntax despite the .yaml extension) per requirements SV-FR-7..24. Covers version/ignored_gates/change_intake/routes/risk_rules/cross_stack/team_recipes/knowledge_focus type, enum, and required-field shape. Deliberately does NOT duplicate: (a) the cross-file reachability/orphan/dangling-reference checks (internal/orchestration/routing_health_test.go) (SV-FR-16/19/22's requires_route note) -- this schema checks reference *shape* (list-of-strings) only; (b) semantic G\\d+ gate-id validity against the live agentic-sdlc gate list -- only string shape is checked here (SV-FR-11/17, AS-3). One cross-field numeric consistency check (cross_stack.minimum_matches <= len(route_ids), and the analogous team_recipes fixed-variant checks, SV-FR-20/SV-FR-22) is NOT expressed here because JSON Schema has no clean way to compare an integer property's value against another property's array length; that check is implemented separately in internal/orchestration/schema_validate.go's supplementary checks, alongside duplicate-id detection per array (SV-FR-12).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "change_intake",
    "routes",
    "risk_rules",
    "cross_stack",
    "team_recipes",
    "knowledge_focus"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "ignored_gates": {
      "$ref": "#/$defs/stringArray"
    },
    "change_intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keywords",
        "agents"
      ],
      "properties": {
        "keywords": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "agents": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "quality_gates": {
          "$ref": "#/$defs/gateIdArray"
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "risk_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/riskRule"
      }
    },
    "cross_stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_ids",
        "minimum_matches"
      ],
      "properties": {
        "route_ids": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "minimum_matches": {
          "type": "integer",
          "minimum": 1
        },
        "support": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "team_recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/teamRecipe"
      }
    },
    "context_packs": {
      "description": "Non-authoring vendor/platform references selected alongside roles; they never declare agents or gates.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "definition"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/nonempty"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "definition": {
            "$ref": "#/$defs/nonempty"
          },
          "paths": {
            "$ref": "#/$defs/stringArray"
          },
          "exclude_paths": {
            "$ref": "#/$defs/stringArray"
          },
          "keywords": {
            "$ref": "#/$defs/nonemptyStringArray"
          },
          "keyword_groups": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/nonemptyStringArray"
            }
          }
        }
      }
    },
    "knowledge_focus": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "default_gate_review_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Reviewer agent ids injected into `support` for each configured lifecycle gate that declares no `review_agents` of its own. Roster-supplied (OD-9, 2026-08-11): this used to be a hardcoded [\"code-reviewer\"] literal in build_dispatch_plan.py, which made a foreign roster's plan raise `Routing selected an unknown agent` because no gate contract has ever declared review_agents OR author_agents -- so the 'fallback' fired unconditionally for every gate on every lifecycle-aware plan. Omit or leave empty to inject nothing, which is what a roster without a general-purpose reviewer should do."
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "gateIdArray": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^G[0-9]+$"
      }
    },
    "routeFieldsBase": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty"
        },
        "paths": {
          "$ref": "#/$defs/stringArray"
        },
        "exclude_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "keywords": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "keyword_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyStringArray"
          }
        },
        "primary": {
          "$ref": "#/$defs/stringArray"
        },
        "reviewers": {
          "$ref": "#/$defs/stringArray"
        },
        "support": {
          "$ref": "#/$defs/stringArray"
        },
        "quality_gates": {
          "$ref": "#/$defs/gateIdArray"
        }
      }
    },
    "route": {
      "allOf": [
        {
          "$ref": "#/$defs/routeFieldsBase"
        }
      ],
      "additionalProperties": false,
      "properties": {
        "id": true,
        "paths": true,
        "exclude_paths": true,
        "keywords": true,
        "keyword_groups": true,
        "primary": true,
        "reviewers": true,
        "support": true,
        "quality_gates": true,
        "workflow_shape": {
          "description": "The delivery shape this route contributes to build_dispatch_plan._select_workflow()'s final stage (#210), naming the kind of artifact the route's roles deliver: 'infrastructure-change' for declarative platform, host, cluster, or network infrastructure; 'pipeline-change' for CI/CD and release-delivery definitions; 'new-service' for application, service, library, or product code; 'unclassified' for a route that claims no delivery shape at all -- advisory, assessment, review, governance, support, documentation, and evidence routes, and routes whose shape is already decided by one of _select_workflow()'s earlier precedence conditions (rollback, production-release, support-escalation, runtime-assurance, knowledge-ingestion, debugging, agent-suite-maintenance, product-intake), which depend on route combinations and keyword evidence a per-route constant cannot express. Optional in this schema so a project-local routing overlay that predates the field still validates -- such a route contributes no shape, exactly as every route did before #210 -- but every route in this repository's own routing.json must declare it, which test_selector.py::WorkflowShapeDeclarationTests enforces. Never derived from the primary role's catalog phase: phase is a capability and authority grouping, and several build-phase routes (opentofu-module-execution, gitlab-ci-execution) deliver infrastructure or pipeline artifacts rather than services.",
          "enum": [
            "new-service",
            "infrastructure-change",
            "pipeline-change",
            "unclassified"
          ]
        }
      }
    },
    "riskRule": {
      "allOf": [
        {
          "$ref": "#/$defs/routeFieldsBase"
        }
      ],
      "additionalProperties": false,
      "properties": {
        "id": true,
        "paths": true,
        "exclude_paths": true,
        "keywords": true,
        "keyword_groups": true,
        "primary": true,
        "reviewers": true,
        "support": true,
        "quality_gates": true,
        "human_gate": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "teamRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "communication_mode",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty"
        },
        "type": {
          "enum": [
            "fixed",
            "dynamic"
          ]
        },
        "communication_mode": {
          "enum": [
            "peer",
            "orchestrator-relayed"
          ]
        },
        "fallback": {
          "enum": [
            "peer",
            "orchestrator-relayed"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonempty"
        },
        "route_ids": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "minimum_matches": {
          "type": "integer",
          "minimum": 1
        },
        "members": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "minimum_members_selected": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "$ref": "#/$defs/nonempty"
        },
        "instances": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "requires_route": {
          "$ref": "#/$defs/nonempty"
        },
        "keywords": {
          "$ref": "#/$defs/nonemptyStringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "communication_mode": {
                "const": "peer"
              }
            },
            "required": [
              "communication_mode"
            ]
          },
          "then": {
            "required": [
              "fallback"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "fixed"
            }
          },
          "required": [
            "type",
            "route_ids",
            "minimum_matches",
            "members",
            "minimum_members_selected"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "role"
                ]
              },
              {
                "required": [
                  "instances"
                ]
              },
              {
                "required": [
                  "requires_route"
                ]
              },
              {
                "required": [
                  "keywords"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "dynamic"
            }
          },
          "required": [
            "type",
            "role",
            "instances",
            "requires_route",
            "keywords"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "route_ids"
                ]
              },
              {
                "required": [
                  "minimum_matches"
                ]
              },
              {
                "required": [
                  "members"
                ]
              },
              {
                "required": [
                  "minimum_members_selected"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
