{
  "name": "@deagy/cadre-lifecycle-cline-plugin",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "cline": {
    "plugins": [
      {
        "paths": [
          "./index.ts"
        ],
        "capabilities": [
          "tools",
          "rules"
        ]
      }
    ]
  },
  "dependencies": {
    "@cline/sdk": "0.0.81",
    "@cline/shared": "0.0.71",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cline/core": "0.0.65",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
