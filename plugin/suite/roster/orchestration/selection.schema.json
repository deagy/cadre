{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agent-selection.schema.json",
  "title": "Local Agent Selection Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "dispatch_fingerprint", "generated_at", "status", "workflow", "inputs", "matched_routes", "matched_route_reasons", "matched_risks", "agents", "dispatch_disposition", "teams", "lifecycle_tracking", "required_quality_gates", "ignored_quality_gates", "human_gates", "knowledge_context"],
  "properties": {
    "schema_version": { "const": 4 },
    "task_id": { "$ref": "#/$defs/nonempty" },
    "dispatch_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ready", "needs-triage"] },
    "workflow": { "enum": ["new-service", "product-intake", "runtime-assurance", "debugging", "infrastructure-change", "pipeline-change", "knowledge-ingestion", "support-escalation", "production-release", "rollback", "unclassified", "needs-triage"] },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "repository_root", "base", "changed_file_source", "changed_files", "classification", "source_filter"],
      "properties": {
        "task": { "$ref": "#/$defs/nonempty" },
        "repository_root": { "$ref": "#/$defs/nonempty" },
        "base": { "type": ["string", "null"], "minLength": 1 },
        "changed_file_source": { "$ref": "#/$defs/nonempty" },
        "changed_files": { "$ref": "#/$defs/stringArray" },
        "classification": { "type": ["string", "null"], "enum": ["public", "internal", "confidential", "restricted", null] },
        "source_filter": { "$ref": "#/$defs/nonempty" }
      }
    },
    "matched_routes": {
      "description": "Matched route ids. An id projection of matched_route_reasons: same ids, same order, same length. Kept as a bare string array for consumers that only need ids; JSON Schema cannot express the positional correspondence, so it is pinned by test_selector.py::RouteMatchReasonTests.",
      "$ref": "#/$defs/stringArray"
    },
    "matched_route_reasons": {
      "description": "Canonical route-match record: why each route matched, as the keywords, keyword_groups, and path pattern/file pairs that fired. Shares one definition with matched_risks so the two shapes cannot drift.",
      "$ref": "#/$defs/idWithReasonsArray"
    },
    "matched_risks": { "$ref": "#/$defs/idWithReasonsArray" },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "reviewers", "support"],
      "properties": {
        "primary": { "$ref": "#/$defs/stringArray" },
        "reviewers": { "$ref": "#/$defs/stringArray" },
        "support": { "$ref": "#/$defs/stringArray" }
      }
    },
    "dispatch_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["staffed", "advisory-only", "no-agents-selected"] },
        "reason": { "$ref": "#/$defs/nonempty" }
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "trigger_reason", "communication_mode", "fallback", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/nonempty" },
          "type": { "enum": ["fixed", "dynamic"] },
          "members": { "$ref": "#/$defs/nonemptyStringArray" },
          "role": { "$ref": "#/$defs/nonempty" },
          "instances": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "integer", "minimum": 1 },
              "max": { "type": "integer", "minimum": 1 }
            }
          },
          "trigger_reason": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "routes": { "$ref": "#/$defs/nonemptyStringArray" },
              "keywords": { "$ref": "#/$defs/nonemptyStringArray" }
            }
          },
          "communication_mode": { "const": "peer" },
          "fallback": { "const": "orchestrator-relayed" },
          "description": { "$ref": "#/$defs/nonempty" }
        },
        "oneOf": [
          {
            "properties": { "type": { "const": "fixed" } },
            "required": ["members"],
            "not": { "anyOf": [{ "required": ["role"] }, { "required": ["instances"] }] }
          },
          {
            "properties": { "type": { "const": "dynamic" } },
            "required": ["role", "instances"],
            "not": { "required": ["members"] }
          }
        ]
      }
    },
    "lifecycle_tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["standalone", "integrated"] },
        "reason": { "$ref": "#/$defs/nonempty" }
      },
      "oneOf": [
        { "properties": { "status": { "const": "standalone" } }, "required": ["reason"] },
        { "properties": { "status": { "const": "integrated" } }, "not": { "required": ["reason"] } }
      ]
    },
    "required_quality_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "reason", "contributing_routes"],
        "properties": {
          "id": { "$ref": "#/$defs/nonempty" },
          "required": { "const": true },
          "reason": { "$ref": "#/$defs/nonempty" },
          "contributing_routes": { "$ref": "#/$defs/nonemptyStringArray" }
        }
      }
    },
    "ignored_quality_gates": { "$ref": "#/$defs/stringArray" },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "reason", "kernel_mutation_gate_id"],
        "properties": {
          "id": { "$ref": "#/$defs/nonempty" },
          "required": { "const": true },
          "reason": { "$ref": "#/$defs/nonempty" },
          "kernel_mutation_gate_id": {
            "description": "Cross-reference to the Agentic SDLC kernel's own contracts/mutation-gates.json id, when one exists for this cadre-side human_gate id. The kernel stays the authoritative definition source; this is a pointer, not a duplicated definition. Null when cadre has no kernel mutation-gate counterpart (e.g. accountable-human-escalation).",
            "type": ["string", "null"]
          }
        }
      }
    },
    "knowledge_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requests"],
      "properties": {
        "status": { "enum": ["not-applicable", "authorization-required", "planned"] },
        "reason": { "$ref": "#/$defs/nonempty" },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "source_filter": { "$ref": "#/$defs/nonempty" },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent", "query", "invocation"],
            "properties": {
              "agent": { "$ref": "#/$defs/nonempty" },
              "query": { "$ref": "#/$defs/nonempty" },
              "invocation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["launcher", "args"],
                "properties": {
                  "launcher": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["runtime", "minimum_version", "resolution"],
                    "properties": {
                      "runtime": { "const": "python" },
                      "minimum_version": { "const": "3.10" },
                      "resolution": { "const": "runner-probed" }
                    }
                  },
                  "args": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/nonempty" } }
                }
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": { "status": { "const": "planned" }, "requests": { "minItems": 1 } },
          "required": ["classification", "source_filter"],
          "not": { "required": ["reason"] }
        },
        {
          "properties": { "status": { "const": "authorization-required" }, "requests": { "maxItems": 0 } },
          "required": ["reason"],
          "not": { "anyOf": [{ "required": ["classification"] }, { "required": ["source_filter"] }] }
        },
        {
          "properties": { "status": { "const": "not-applicable" }, "requests": { "maxItems": 0 } },
          "not": { "anyOf": [{ "required": ["reason"] }, { "required": ["classification"] }, { "required": ["source_filter"] }] }
        }
      ]
    },
    "provenance": {
      "description": "Optional, additive suite-input provenance binding (idea #7). Distinct from and complementary to dispatch_fingerprint: dispatch_fingerprint is a self-consistency checksum over this plan's own emitted content (excludes generated_at and provenance itself); provenance binds the plan to the exact catalog.yaml/routing-configuration content, and best-effort git commit identity, that produced it, independently verifiable without trusting the generating process. Absent entirely on plans built without a matching on-disk catalog/routing file (e.g. in-process fixtures/tests) -- not required at the top level, so plans generated before this field existed remain valid.",
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_content_hash", "routing_content_hash"],
      "properties": {
        "catalog_content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "routing_content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "git_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "git_dirty_paths": { "$ref": "#/$defs/stringArray" },
        "overlay_applied": {
          "description": "Reserved for idea #6 (project-local routing overlay). Currently dormant: select_agents.py's dispatch-plan call path never resolves an overlay, so this and the sibling overlay_* fields are always absent, never fabricated.",
          "const": true
        },
        "overlay_content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "overlay_path": { "$ref": "#/$defs/nonempty" },
        "runner_capabilities_content_hash": {
          "description": "Reserved for a possible future dispatch-time read of roster/runner-capabilities.json (idea #8). Not populated by this schema version: the manifest is build/generator-time only today and is already transitively covered by catalog_content_hash, so populating this without an actual causal read path would misrepresent what produced the plan.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "agentic_sdlc_contract_version": {
          "description": "The lifecycle-gates contract's own version integer, recorded only when lifecycle_tracking.status is \"integrated\". Records which already-consumed, already-version-checked external contract shape Cadre's own code used -- not an assertion about the agentic-sdlc kernel's own repository/commit identity, gate-approval state, or run-record validity (see the two-repo boundary in AGENTS.md/CLAUDE.md).",
          "type": "integer"
        }
      },
      "if": {
        "not": {
          "properties": { "overlay_applied": { "const": true } },
          "required": ["overlay_applied"]
        }
      },
      "then": {
        "not": { "anyOf": [{ "required": ["overlay_content_hash"] }, { "required": ["overlay_path"] }] }
      }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "matchReasons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywords", "keyword_groups", "paths"],
      "properties": {
        "keywords": { "$ref": "#/$defs/stringArray" },
        "keyword_groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonemptyStringArray" }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "file"],
            "properties": {
              "pattern": { "$ref": "#/$defs/nonempty" },
              "file": { "$ref": "#/$defs/nonempty" }
            }
          }
        }
      }
    },
    "idWithReasonsArray": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reasons"],
        "properties": {
          "id": { "$ref": "#/$defs/nonempty" },
          "reasons": { "$ref": "#/$defs/matchReasons" }
        }
      }
    }
  }
}
