#!/bin/sh
# Entry point for this repository's lifecycle kernel. Builds (if needed) and
# execs the Go implementation under cmd/agentic-sdlc.
#
# This ran the Python kernel until every subcommand had a Go counterpart
# gated on a differential against it. The Python package is still here and
# still tested -- it is the other half of that gate -- but nothing in a
# checkout runs it any more.
#
# A separate binary from `cadre`, deliberately. The kernel owns lifecycle gate
# schemas, run-record validation and gate-authority semantics; roster/ asks and
# the kernel answers. Shipping them as one binary would make an in-process
# shortcut across that boundary a one-line change.
set -eu

# Portable symlink resolution (no GNU-only `readlink -f`): follow symlinks
# until the target is a real file, then take that file's directory. This shim
# is put on PATH by name, so it must work through a symlink.
resolve_script_dir() {
  target="$1"
  while [ -L "$target" ]; do
    dir=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd)
    target=$(readlink -- "$target")
    case "$target" in
      /*) ;;
      *) target="$dir/$target" ;;
    esac
  done
  CDPATH= cd -- "$(dirname -- "$target")" && pwd
}

BIN_DIR=$(resolve_script_dir "$0")
REPO_ROOT=$(CDPATH= cd -- "$BIN_DIR/.." && pwd)

# Rebuild only when Go source is newer than the cached binary, so repeat
# invocations stay fast without a separate `make build` step. Its own cache
# entry, not `bin/cadre`'s: the two are different binaries and a shared name
# would have each rebuild over the other.
BUILD_CACHE="${CADRE_BUILD_CACHE:-$REPO_ROOT/.cadre-build-cache}"
BINARY="$BUILD_CACHE/agentic-sdlc"

NEEDS_BUILD=1
if [ -x "$BINARY" ]; then
  NEEDS_BUILD=0
  NEWEST_SRC=$(find "$REPO_ROOT/cmd" "$REPO_ROOT/internal" -name '*.go' -newer "$BINARY" -print -quit 2>/dev/null)
  [ -n "$NEWEST_SRC" ] && NEEDS_BUILD=1
fi

if [ "$NEEDS_BUILD" = 1 ]; then
  # Checked here rather than up front: a warm cache needs no toolchain, and
  # demanding one anyway makes the kernel unusable under a deliberately
  # narrowed PATH -- which is how some tests make an unrelated dependency
  # unresolvable.
  command -v go >/dev/null 2>&1 || {
    echo "agentic-sdlc: Go is required to build this checkout's kernel (checked PATH for 'go')" >&2
    exit 1
  }
  mkdir -p "$BUILD_CACHE"
  # CGO_ENABLED=0 deliberately: the kernel links no C, so this builds without
  # a C toolchain and produces the same binary on every machine. `cadre` needs
  # cgo for its sqlite-backed knowledge store and pays for it with a fallback
  # path; nothing here does.
  #
  # Silent on success, verbatim on failure. `go build` writes progress to
  # stderr on a cold module cache, and that is indistinguishable from kernel
  # diagnostics to anything reading this wrapper's stderr -- `--version`'s
  # empty-stderr contract depends on this being buffered.
  BUILD_LOG="$BUILD_CACHE/agentic-sdlc-build.log"
  if ! ( cd "$REPO_ROOT" && CGO_ENABLED=0 go build -o "$BINARY" ./cmd/agentic-sdlc ) >"$BUILD_LOG" 2>&1; then
    echo "agentic-sdlc: failed to build the Go kernel from $REPO_ROOT" >&2
    cat "$BUILD_LOG" >&2
    rm -f "$BUILD_LOG"
    exit 1
  fi
  rm -f "$BUILD_LOG"
fi

exec "$BINARY" "$@"
