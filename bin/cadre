#!/bin/sh
# Entry point for this repository's `cadre` CLI. Builds (if needed) and
# execs the Go implementation under cmd/cadre -- the authoritative CLI as of
# the Python-to-Go migration (see ADR-001-CLI-GO-REFACTOR.md). Safe to
# invoke via a symlink on PATH (see README.md "System-wide install") or
# directly as ./bin/cadre from this checkout.
set -eu

# Portable symlink resolution (no GNU-only `readlink -f`): follow symlinks
# until the target is a real file, then take that file's directory.
resolve_script_dir() {
  target="$1"
  while [ -L "$target" ]; do
    dir=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd)
    target=$(readlink -- "$target")
    case "$target" in
      /*) ;;
      *) target="$dir/$target" ;;
    esac
  done
  CDPATH= cd -- "$(dirname -- "$target")" && pwd
}

BIN_DIR=$(resolve_script_dir "$0")
REPO_ROOT=$(CDPATH= cd -- "$BIN_DIR/.." && pwd)

# Rebuild only when Go source is newer than the cached binary, so a bare
# `./bin/cadre` stays fast on repeat invocations without needing a separate
# `make build` step first. CADRE_BUILD_CACHE lets CI or a wrapper pin the
# cache location explicitly.
BUILD_CACHE="${CADRE_BUILD_CACHE:-$REPO_ROOT/.cadre-build-cache}"
BINARY="$BUILD_CACHE/cadre"

NEEDS_BUILD=1
if [ -x "$BINARY" ]; then
  NEEDS_BUILD=0
  NEWEST_SRC=$(find "$REPO_ROOT/cmd" "$REPO_ROOT/internal" -name '*.go' -newer "$BINARY" -print -quit 2>/dev/null)
  [ -n "$NEWEST_SRC" ] && NEEDS_BUILD=1
fi

if [ "$NEEDS_BUILD" = 1 ]; then
  # Checked here, not up front: a warm cache needs no toolchain, and
  # demanding one anyway made `cadre` unusable under a deliberately narrowed
  # PATH -- which is how callers make some *other* dependency unresolvable
  # for a test (cline-plugins/cline/index.test.mts hides `agentic-sdlc` this
  # way and was hiding `go` as collateral damage).
  command -v go >/dev/null 2>&1 || { echo "cadre: Go is required to build this checkout's CLI (checked PATH for 'go')" >&2; exit 1; }
  mkdir -p "$BUILD_CACHE"
  # Silent on success, verbatim on failure. `go build` writes progress to
  # stderr on a cold module cache ("go: downloading ..."), and that is
  # indistinguishable from CLI diagnostics to anything reading this
  # wrapper's stderr: it broke `cadre --version`'s "writes nothing to
  # stderr" contract (test_cli_surface.py::GlobalVersionTest) and made the
  # Cline vitest suites, which fail a run on unexpected stderr, time out.
  # Buffering it here loses nothing -- a real build failure is replayed in
  # full before exiting non-zero.
  BUILD_LOG="$BUILD_CACHE/build.log"
  # cgo first, then a cgo-less retry.
  #
  # `cadre context` and the engine's SQLite executor need the cgo-backed
  # sqlite3 driver (mattn/go-sqlite3). A CGO_ENABLED=0 binary still builds and
  # links cleanly -- the driver ships a cgo-less stub -- but those calls then
  # fail at runtime with "Binary was compiled with 'CGO_ENABLED=0'". Nothing
  # warns at build time. `go env CGO_ENABLED` is 0 on plenty of machines, so
  # this wrapper was silently producing partly-broken binaries.
  #
  # This used to say `cadre knowledge`, and that was the reason the fallback
  # exists. It is no longer true: retrieval moved to recall and the staged
  # store to modernc.org/sqlite, both pure Go, so the whole knowledge path
  # works in a cgo-less build. The fallback still earns its place for the
  # remaining two.
  #
  # Forcing CGO_ENABLED=1 unconditionally is *not* the fix: without a C
  # toolchain that fails the entire build ("cgo: C compiler not found"),
  # which would leave `cadre` completely unusable on a machine where today
  # only part of it is. So prefer the full binary, fall back to the degraded
  # one, and let `cadre doctor` report which one you ended up with.
  #
  # Neither path writes to stderr on success -- both are buffered for the
  # reason described above, and `cadre --version`'s empty-stderr contract
  # (test_cli_surface.py) holds whichever branch runs.
  if ! ( cd "$REPO_ROOT" && CGO_ENABLED=1 go build -o "$BINARY" ./cmd/cadre ) >"$BUILD_LOG" 2>&1; then
    if ! ( cd "$REPO_ROOT" && CGO_ENABLED=0 go build -o "$BINARY" ./cmd/cadre ) >>"$BUILD_LOG" 2>&1; then
      echo "cadre: failed to build the Go CLI from $REPO_ROOT" >&2
      cat "$BUILD_LOG" >&2
      rm -f "$BUILD_LOG"
      exit 1
    fi
  fi
  rm -f "$BUILD_LOG"
fi

# Tell the built binary which checkout produced it. Without this it can only
# find its own roster/ by walking up from the caller's working directory,
# which is wrong twice over: the binary lives under .cadre-build-cache/ (or
# anywhere on PATH), and `cadre` is routinely run from another project --
# the directory whose *contents* --root describes, not the one whose
# implementation should be used.
CADRE_REPO_ROOT="$REPO_ROOT"
export CADRE_REPO_ROOT

exec "$BINARY" "$@"
